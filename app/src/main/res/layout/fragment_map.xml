<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Full-screen WebView map -->
    <WebView
        android:id="@+id/webMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Filter chips -->
    <HorizontalScrollView
        android:id="@+id/scrollChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:background="#CC0D1117"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🗺 Όλα"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="6dp"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeColor="@color/primary"
                app:chipStrokeWidth="1dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAqi"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="💨 AQI"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="6dp"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeColor="@color/primary"
                app:chipStrokeWidth="1dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipParks"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🌳 Πάρκα"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="6dp"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeColor="@color/primary"
                app:chipStrokeWidth="1dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSquares"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⛲ Πλατείες"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="6dp"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeColor="@color/primary"
                app:chipStrokeWidth="1dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTransit"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🚇 ΜΜΜ"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeColor="@color/primary"
                app:chipStrokeWidth="1dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipParking"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🅿️ Στάθμευση"
                android:textColor="@color/text_primary"
                android:layout_marginStart="6dp"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeColor="@color/primary"
                app:chipStrokeWidth="1dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTraffic"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🚦 Φανάρια"
                android:textColor="@color/text_primary"
                android:layout_marginStart="6dp"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeColor="@color/primary"
                app:chipStrokeWidth="1dp"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- My Location FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_my_location"
        android:contentDescription="Η τοποθεσία μου"
        app:backgroundTint="@color/primary"
        app:tint="@color/white"
        app:fabSize="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Gyroscope Map Lock FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabGyroLock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_compass" 
        android:contentDescription="Κλείδωμα πυξίδας/συνημιτόνου"
        app:backgroundTint="#424242"
        app:tint="@color/white"
        app:fabSize="normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
